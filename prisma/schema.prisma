// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  connectionCode String?
  description      String?
  address       String?
  phoneNumber   String?
  linkedinLink  String?
  githubLink    String?
  photos        String[]   @default([])
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  tools         Tool[]
  frameworks    Framework[]
  projects      Project[]
  certifications Certification[]
  aboutMes      AboutMe[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress  String?
  userAgent  String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String   @id
  accountId             String
  providerId            String
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

enum ToolCategory {
  FRONTEND 
  BACKEND
  DATABASE
  DEVOPS
  TESTING
  VERSION_CONTROL
  LANGUAGE
  UI_TOOLKIT
  API
  MOBILE
  CLOUD
  MONITORING
  SECURITY
  CACHING_LAYER
  ORM
  TASK_SCHEDULING
  BACKEND_AUTOMATION
}

enum AboutMeCategory {
  PERSONAL_BACKGROUND
  TECHNICAL_EXPERTISE
  WORK_PHILOSOPHY
  CAREER_HIGHLIGHTS
  CONTINUOUS_LEARNING
  WORK_EXPERIENCE
  EDUCATIONAL_BACKGROUND
}

enum ProjectType {
  MOBILE_APPLICATION
  DESKTOP_APPLICATION
  WEB_APPLICATION
}

model Tool {
  id        String       @id @default(cuid())
  name      String       @unique
  picture   String?
  category  ToolCategory
  createdBy String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  creator   User         @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  frameworks Framework[]

  @@map("tool")
}

model Framework {
  id        String   @id @default(cuid())
  name      String   @unique
  image     String?
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  creator   User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  tools     Tool[]
  projects  Project[]

  @@map("framework")
}

model Project {
  id          String       @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  githubLink  String?
  previewLink String?
  type        ProjectType  @default(WEB_APPLICATION)
  roles       String[]     @default([])
  createdBy   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  frameworkId String
  framework   Framework    @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  creator     User         @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  aboutMeId   String?
  aboutMe     AboutMe?     @relation(fields: [aboutMeId], references: [id], onDelete: SetNull)

  @@map("project")
}

model Certification {
  id          String   @id @default(cuid())
  name        String
  description String?
  image       String?
  dateIssued  DateTime @default(now())
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  creator     User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("certification")
}

model AboutMe {
  id          String   @id @default(cuid())
  category    AboutMeCategory
  title       String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  isPresent   Boolean  @default(false)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  creator     User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  projects    Project[]

  @@map("about_me")
}